# Maintainer: TuneX Contributors
# V1 AUR artifact (D-011b): CMake + Corrosion build of the git tree,
# installing the binary, desktop entry, icon, and license text. Verified via
# `makepkg --printsrcinfo` + `namcap` + a full local `makepkg` build; the
# clean-chroot run (`extra-x86_64-build`, needs root) is maintainer follow-up.
pkgname=tunex
pkgver=0.1.0
pkgrel=1
pkgdesc="Local-first music player for Linux (Rust + Qt Quick)"
arch=('x86_64')
url="https://github.com/PerkyZZ999/TuneX"
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-declarative' 'gstreamer' 'gst-plugins-base' 'gst-plugins-good' 'gst-plugins-bad' 'gst-plugins-ugly' 'gst-libav' 'sqlite' 'hicolor-icon-theme')
makedepends=('cmake' 'ninja' 'rust' 'git' 'qt6-shadertools' 'pkgconf')
source=("tunex::git+${url}.git")
sha256sums=('SKIP')
# The cxx-qt bridge links generated C++ objects statically into the Rust
# binary; makepkg's default LTO poisons that mixed-language link with
# unresolved `cxxbridge1$…` symbols, so LTO stays off for this package.
options=('!lto')

prepare() {
    cd tunex
    # Pre-warm the Cargo cache so a stale lockfile fails here with a clear
    # error instead of deep in the CMake build.
    cargo fetch --locked
}

build() {
    # Clean chroots and AUR helpers both build with network access, so
    # Corrosion arrives via FetchContent at configure time (pinned v0.6.1 in
    # CMakeLists.txt) and crates via `cargo fetch` above — nothing vendored.
    cmake -B build -S tunex -G Ninja -DCMAKE_BUILD_TYPE=RelWithDebInfo
    cmake --build build
}

package() {
    # `build/` sits beside the `tunex/` checkout (`cmake -B build -S tunex`).
    install -Dm755 build/tunex "$pkgdir/usr/bin/tunex"
    install -Dm644 tunex/packaging/aur/tunex.desktop "$pkgdir/usr/share/applications/tunex.desktop"
    install -Dm644 tunex/packaging/aur/tunex.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/tunex.png"
    install -Dm644 tunex/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
